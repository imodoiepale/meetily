# Same Supabase project as citiwalk-task-manager. Meetings tables live in the
# `meetings` schema; people, departments and tasks stay in `public`.
#
# Host this app separately from Task Manager. Copy the Task Manager values
# below. After migrate, add `meetings` under Project Settings → API → Exposed
# schemas.

# Supabase → Project Settings → API (same project as Task Manager)
NEXT_PUBLIC_SUPABASE_URL=https://ynbzlvircyawpzarfapn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres schema for minutes / attendees / guests / WhatsApp
SUPABASE_DB_SCHEMA=meetings

# Origin of this separately hosted app (guest links, password emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3118

# Shared with Task Manager. Desktop Preferences stores the same value.
# Header: X-CityWalk-Ingest-Secret
MEETINGS_INGEST_SECRET=

# Hosted OpenWA. Server-only. Never put these in the desktop binary.
OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_API_STYLE=rest

# Tauri signing (desktop builds)
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
